							<string># `date` is a nanosecond field—this query shows the date in UTC

SELECT
  ROWID,
  datetime(message.date/1000000000 + strftime("%s", "2001-01-01") ,"unixepoch","localtime") AS date_utc,
  text
FROM message
WHERE is_read = 0
  AND is_from_me = 0
  AND is_delivered = 1
 ORDER BY date DESC;</string>
