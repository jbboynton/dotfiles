							<key>Text</key>
							<string>-- Remember the folder of the frontmost Finder window when leaving Finder, so
-- a new window can open there even after every Finder window is closed.
tell application "Finder"
	try
		if (count of Finder windows) &gt; 0 then
			set p to POSIX path of ((target of Finder window 1) as alias)
			tell application "Keyboard Maestro Engine" to setvariable "FinderLastFolder" to p
		end if
	end try
end tell
</string>
