							<string>None</string>
							<key>HonourFailureSettings</key>
							<true/>
							<key>IncludeStdErr</key>
							<true/>
							<key>IncludedVariables</key>
							<array>
								<string>9999</string>
							</array>
							<key>MacroActionType</key>
							<string>ExecuteAppleScript</string>
							<key>Path</key>
							<string></string>
							<key>Text</key>
							<string>-- New Firefox window in the current Space.
-- Firefox's own command line activates Firefox before making the window, and
-- macOS then switches to a Space that already has a Firefox window. Pressing
-- the menu item through Accessibility makes the window here without
-- activating; raising it first means activating Firefox stays on this Space.
set appName to "Firefox Developer Edition"

if application appName is not running then
	do shell script "open -a " &amp; quoted form of appName &amp; " --args --private-window --profile " &amp; quoted form of "/Users/james/Library/Application Support/Firefox/Profiles/8fyqwfpz.dev-edition-default"
	return
end if

tell application "System Events" to tell process "firefox"
	set startCount to count of windows
	click menu item "New Private Window" of menu "File" of menu bar item "File" of menu bar 1

	repeat 60 times
		if (count of windows) &gt; startCount then exit repeat
		delay 0.05
	end repeat

	if (count of windows) &gt; startCount then perform action "AXRaise" of window 1
	set frontmost to true
end tell
</string>
