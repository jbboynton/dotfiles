							<key>Path</key>
							<string></string>
							<key>Text</key>
							<string>-- New Finder window at the folder of the Finder window used last.
-- Finder lists its windows most recently used first, across every Space. With
-- no windows open, fall back to the folder saved when Finder was last left
-- (the "Remember the last Finder folder" macro), then to the home folder.
set dest to missing value

tell application "Finder"
	try
		if (count of Finder windows) &gt; 0 then set dest to (target of Finder window 1) as alias
	end try
end tell

if dest is missing value then
	tell application "Keyboard Maestro Engine" to set saved to getvariable "FinderLastFolder"

	if saved is not "" then
		try
			set dest to (POSIX file saved) as alias
		end try
	end if
end if

tell application "Finder"
	if dest is missing value then set dest to (path to home folder)
	make new Finder window to dest
	activate
end tell
