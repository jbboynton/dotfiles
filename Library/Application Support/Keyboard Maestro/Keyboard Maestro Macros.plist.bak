						</dict>
						<dict>
							<key>ActionUID</key>
							<integer>90508</integer>
							<key>Asynchronously</key>
							<false/>
							<key>MacroActionType</key>
							<string>ExecuteMacro</string>
							<key>MacroUID</key>
							<string>4A1785A1-8CCE-4A20-B39B-BE9F5BDCF704</string>
							<key>TimeOutAbortsMacro</key>
							<true/>
							<key>UseParameter</key>
							<false/>
						</dict>
					</array>
					<key>CreationDate</key>
					<real>809087263.27297699</real>
					<key>ModificationDate</key>
					<real>809087346.42936003</real>
					<key>Name</key>
					<string>Conditionally stop "Enhance Desk Mic" session</string>
					<key>Triggers</key>
					<array>
						<dict>
							<key>Attach</key>
							<false/>
							<key>MacroTriggerType</key>
							<string>USBDevice</string>
							<key>Name</key>
							<string>Scarlett 4i4 USB</string>
							<key>TargetType</key>
							<string>Named</string>
						</dict>
					</array>
					<key>UID</key>
					<string>CF51FFDD-3F7C-4863-931D-C48A0CC2FB72</string>
				</dict>
				<dict>
					<key>Actions</key>
					<array>
						<dict>
							<key>ActionName</key>
							<string>Turn Desk Mic + Mic Pass-Thru on/off in Loopback (device names: CONFIG block at top)</string>
							<key>ActionUID</key>
							<integer>91300</integer>
							<key>DisplayKind</key>
							<string>None</string>
							<key>HonourFailureSettings</key>
							<true/>
							<key>IncludeStdErr</key>
							<true/>
							<key>IncludedVariables</key>
							<array>
								<string>9999</string>
							</array>
							<key>MacroActionType</key>
							<string>ExecuteAppleScript</string>
							<key>Path</key>
							<string></string>
							<key>Text</key>
							<string>-- ================= CONFIG — edit here if names change =================
-- Loopback device names, exactly as shown in Loopback's device list
-- (case- and punctuation-sensitive).
-- If you rename one in Loopback, also update:
--   • Audio Hijack › "Enhance Desk Mic" › Output Device block (Mic Pass-Thru)
--   • Loopback › Desk Mic › Sources (Mic Pass-Thru)
--   • SoundSource's device order, if you've prioritised them there
set targets to {"Desk Mic", "Mic Pass-Thru"}
-- Desired state comes from the global KM variable DeskMicLoopbackWant
-- ("1" = on, "0" = off), set by the calling macro just before it runs this one.
-- ======================================================================

tell application "Keyboard Maestro Engine" to set wantStr to getvariable "DeskMicLoopbackWant"
if wantStr is not in {"0", "1"} then my fail("DeskMicLoopbackWant must be 0 or 1, got \"" &amp; wantStr &amp; "\".")
set wantOn to (wantStr is "1")

set wasRunning to application "Loopback" is running
do shell script "open -g -a Loopback"

-- Find the device list. macOS only exposes windows on the CURRENT Space, so a Loopback
-- window sitting in another Space (or a closed window) is invisible to this script.
-- If Loopback is running but no window is reachable, relaunch it in the background:
-- its window then opens in this Space. Loopback devices keep working while it restarts.
set lst to my findDeviceList(5)
if lst is missing value and wasRunning then
	tell application "Loopback" to quit
	repeat 150 times
		if (do shell script "pgrep -x Loopback &gt;/dev/null &amp;&amp; echo 1 || echo 0") is "0" then exit repeat
		delay 0.1
	end repeat
	if (do shell script "pgrep -x Loopback &gt;/dev/null &amp;&amp; echo 1 || echo 0") is "1" then my fail("Loopback's window isn't reachable (another Space?) and Loopback wouldn't quit so it could be reopened here.")
	do shell script "open -g -a Loopback"
	set lst to my findDeviceList(15)
end if
if lst is missing value then my fail("Couldn't find Loopback's device list. Its window may be in another Space, or Loopback's UI may have changed.")

-- Pass 1: find every target and its switch. Change nothing yet.
set switches to {}
set found to {}
tell application "System Events"
	repeat with dev in UI elements of lst
		set devName to value of attribute "AXTitle" of dev
		if devName is in targets then
			try
				set end of switches to (first UI element of dev whose description is "Switch")
				set end of found to devName
			on error
				my fail("Found \"" &amp; devName &amp; "\" in Loopback but not its On/Off switch.")
			end try
		end if
	end repeat
end tell

set missing to {}
repeat with t in targets
	if (t as text) is not in found then set end of missing to (t as text)
end repeat
if missing is not {} then my fail("Not listed in Loopback: " &amp; my joinList(missing) &amp; ". Nothing was changed.")

-- Pass 2: flip whatever isn't already in the wanted state.
tell application "System Events"
	repeat with sw in switches
		set isOn to (value of attribute "AXValueDescription" of sw) is "On"
		if isOn is not wantOn then
			perform action "AXPress" of sw
			-- Loopback asks for confirmation when another app (e.g. Audio Hijack) is still using
			-- the device. Do not auto-confirm: leave the dialog up and fail loudly.
			delay 0.5
			if my confirmationShowing() then
				my fail("Loopback is asking to confirm turning a device off because another app (probably Audio Hijack) is still using it. Answer the Loopback dialog.")
			end if
		end if
	end repeat
end tell

if not wasRunning then
	delay 0.5
	tell application "Loopback" to quit
end if

-- Pass 3: confirm macOS actually sees the result (up to ~5 s).
repeat with t in targets
	set ok to false
	repeat 10 times
		set seen to do shell script "system_profiler SPAudioDataType 2&gt;/dev/null | grep -qxF " &amp; quoted form of ("        " &amp; t &amp; ":") &amp; " &amp;&amp; echo 1 || echo 0"
		if (seen is "1") is wantOn then
			set ok to true
			exit repeat
		end if
		delay 0.5
	end repeat
	if not ok then
		if wantOn then
			my fail("\"" &amp; t &amp; "\" was switched on in Loopback but macOS doesn't list it.")
		else
			my fail("\"" &amp; t &amp; "\" was switched off in Loopback but macOS still lists it.")
		end if
	end if
end repeat

on findDeviceList(timeoutSecs)
	repeat (timeoutSecs * 10) times
		tell application "System Events"
			if exists process "Loopback" then
				-- Search every window: a confirmation dialog can sit in front of the main one.
				repeat with w in (windows of process "Loopback")
					try
						return (first UI element of w whose description is "list")
					end try
				end repeat
			end if
		end tell
		delay 0.1
	end repeat
	return missing value
end findDeviceList

on confirmationShowing()
	-- Loopback main window and its confirmation prompt both report the dialog subrole,
	-- so tell them apart by content: any Loopback window without the device list is the prompt.
	tell application "System Events"
		repeat with w in (windows of process "Loopback")
			try
				first UI element of w whose description is "list"
			on error
				return true
			end try
		end repeat
	end tell
	return false
end confirmationShowing

on fail(msg)
	display notification msg with title "Desk Mic Loopback toggle FAILED" sound name "Basso"
	error "Desk Mic Loopback toggle: " &amp; msg
end fail

on joinList(xs)
	set AppleScript's text item delimiters to ", "
	set s to xs as text
	set AppleScript's text item delimiters to ""
	return s
end joinList
</string>
