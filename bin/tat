#!/bin/sh
#
# Attach or create tmux session named the same as current directory.

# Never from Claude Code (it sets CLAUDECODE): inside tmux this switches
# James's terminal to another session, and outside it starts a server
if [ -n "$CLAUDECODE" ]; then
  mark='‼︎'

  if [ -t 2 ] && [ -z "$NO_COLOR" ]; then
    mark=$(printf '\033[1;31m‼︎\033[0m')
  fi

  printf '%s tat does not run under Claude Code (CLAUDECODE is set)\n\n' \
    "$mark" >&2
  exit 1
fi

path_name="$(basename "$PWD" | tr . -)"
session_name=${1-$path_name}

not_in_tmux() {
  [ -z "$TMUX" ]
}

session_exists() {
  tmux list-sessions | sed -E 's/:.*$//' | grep -q "^$session_name$"
}

create_detached_session() {
  (TMUX='' tmux new-session -Ad -s "$session_name")
}

create_if_needed_and_attach() {
  if not_in_tmux; then
    tmux new-session -As "$session_name"
  else
    if ! session_exists; then
      create_detached_session
    fi
    tmux switch-client -t "$session_name"
  fi
}

create_if_needed_and_attach
