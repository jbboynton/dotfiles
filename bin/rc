#!/usr/bin/env bash
# A safe front end to rcm. Nothing in your home folder is ever overwritten:
# links are made with `ln -s` (no -f), copies with `cp -n` and moves with
# `mv -n`, so an existing file or link makes the step fail rather than be
# replaced, and every step is checked afterwards. Only --force goes further,
# and even then whatever is in the way is moved to ~/.rc-displaced/ first,
# never deleted.
#
# rcm itself is only used to read its file list (lsrc). Its own commands are
# blocked by shims in ~/.bin; see `rc help`.

set -euo pipefail

repo="$HOME/.dotfiles"
rcrc="$repo/rcrc"
displaced="$HOME/.rc-displaced"
rcm_bin="${HOMEBREW_PREFIX:-/opt/homebrew}/bin"

# The real lsrc, ahead of the shim in ~/.bin
export PATH="$rcm_bin:$PATH"

help() {
  cat << 'EOF'
rc: manage ~/.dotfiles without ever overwriting a file.

  rc add ~/.foo                  move ~/.foo into ~/.dotfiles, link it back
  rc add --undotted ~/Brewfile   same, for a file with no leading dot
  rc add --copy FILE             install as a copy instead of a link
                                 (LaunchAgents: launchd won't load a link)
  rc sync                        pull from GitHub (fast-forward only), then
                                 link and prune: the way to pick up changes
                                 made on another Mac
  rc link                        link everything into ~; anything in the
                                 way is skipped and listed. Copies that are
                                 just out of date get updated (old one
                                 moved to ~/.rc-displaced/)
  rc link --force                also replace what's in the way, moving it
                                 to ~/.rc-displaced/ first
  rc unlink ~/.foo               remove a link into ~/.dotfiles
                                 (never a real file; rc link puts it back)
  rc rename ~/.bin/foo bar       rename a managed file in the repo (git mv,
                                 so history is kept) and move its link to
                                 match; same folder only. Refuses unless
                                 everything is exactly as expected
  rc prune                      remove broken links into ~/.dotfiles
  rc ls                          list everything that's managed
  rc help                        this

Add --dry-run (or -n) to any command except ls to see what would happen
without changing anything.

rcm's own mkrc, rcup, rcdn and lsrc are blocked; use rc.
EOF
  open_group=1
}

# Output comes in groups with a blank line between them, and always ends
# with one, so the prompt sits a line below the last thing printed.
# out and err print a line; gap closes the current group.
open_group=0

out() {
  printf '%s\n' "$*"
  open_group=1
}

err() {
  printf '%s\n' "$*" >&2
  open_group=1
}

gap() {
  if [ "$open_group" -eq 1 ]; then
    echo
    open_group=0
  fi
}

trap gap EXIT

# Colors only on a terminal, and never with NO_COLOR set
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  bold=$'\033[1m'
  blue=$'\033[34m'
  cyan=$'\033[36m'
  green=$'\033[32m'
  yellow=$'\033[33m'
  red=$'\033[31m'
  reset=$'\033[0m'
else
  bold=""
  blue=""
  cyan=""
  green=""
  yellow=""
  red=""
  reset=""
fi

# Icons for headings, errors and notes
icon_heading="☞"
icon_error="‼︎"
icon_note="Ꙫ!"

# One line about one file, led by a colored marker. Callers pass a short
# code; one-character markers are padded so every path lines up:
# + added ✓⧾, ~ changed ✓✧, - removed ⨉, ! skipped ◌, x failed ⚑ (stderr)
item() {
  local mark="$1" glyph color

  shift

  case "$mark" in
    +) glyph="✓⧾"; color="$green" ;;
    "~") glyph="✓✧"; color="$cyan" ;;
    -) glyph="⨉ "; color="$cyan" ;;
    !) glyph="◌ "; color="$yellow" ;;
    x) glyph="⚑ "; color="$red" ;;
  esac

  if [ "$mark" = "x" ]; then
    err "$color$glyph$reset $*"
  else
    out "$color$glyph$reset $*"
  fi
}

# A heading: blue pointing hand, bold text
heading() {
  out "$blue$icon_heading$reset $bold$*$reset"
}

# A count for a summary line, colored only when it isn't zero
tally() {
  local count="$1" label="$2" color="$3"

  if [ "$count" -gt 0 ]; then
    printf '%s%s %s%s' "$color" "$count" "$label" "$reset"
  else
    printf '%s %s' "$count" "$label"
  fi
}

# After passed-through output: the closing blank line only on a terminal,
# so piping rc ls into grep stays clean
list_end() {
  if [ -t 1 ]; then
    open_group=1
  fi
}

die() {
  gap
  err "$red$bold$icon_error$reset $*"
  exit 1
}

# Show a path the way it would be typed, with ~ for the home folder
shown() {
  printf '%s' "${1/#"$HOME"/\~}"
}

# Absolute path of an argument, without following a final symlink
absolute() {
  printf '%s/%s' "$(cd "$(dirname "$1")" && pwd)" "$(basename "$1")"
}

# Whether anything at all is at a path, broken links included
occupied() {
  [ -e "$1" ] || [ -L "$1" ]
}

# Whether a file matches some committed version of a repo path, meaning git
# has its contents and nothing is lost by replacing it
committed_before() {
  local rel="$1" file="$2" hash

  hash="$(git -C "$repo" hash-object -- "$file" 2>/dev/null)" || return 1
  git -C "$repo" log --all --format= --raw --no-abbrev -- "$rel" 2>/dev/null |
    grep -q " $hash "
}

# What `rc link` would do with one rcm entry: ok, new, stale (an untouched
# copy of an older committed version) or conflict. Kind is rcm's marker: @
# for a link, X for a copy.
link_state() {
  local dest="$1" src="$2" kind="$3"

  # Nothing there yet
  if ! occupied "$dest"; then
    echo new
    return
  fi

  # Already the right link, or an identical copy
  if [ "$kind" = "X" ]; then
    if [ -f "$dest" ] && [ ! -L "$dest" ]; then
      if cmp -s "$dest" "$src"; then
        echo ok
        return
      fi

      # Out of date, but never edited here: the repo moved on (a pull)
      if committed_before "${src#"$repo"/}" "$dest"; then
        echo stale
        return
      fi
    fi
  elif [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then
    echo ok
    return
  fi

  echo conflict
}

# How to reload a LaunchAgent copy after it changes, if that's what it is
reload_hint() {
  local dest="$1" label

  if [[ $dest == "$HOME/Library/LaunchAgents/"*.plist ]]; then
    label="$(basename "$dest" .plist)"
    out "  ${cyan}reload it:$reset launchctl bootout gui/\$(id -u)/$label; launchctl bootstrap gui/\$(id -u) $(shown "$dest")"
  fi
}

# Link or copy one file into an empty spot, refusing to replace anything
install_one() {
  local src="$1" dest="$2" kind="$3"

  mkdir -p "$(dirname "$dest")" 2>/dev/null || return 1

  if [ "$kind" = "X" ]; then
    /bin/cp -pn "$src" "$dest" 2>/dev/null || return 1
    [ ! -L "$dest" ] && cmp -s "$src" "$dest"
  else
    ln -s "$src" "$dest" 2>/dev/null || return 1
    [ "$(readlink "$dest")" = "$src" ]
  fi
}

# Move whatever is at a path into ~/.rc-displaced/<when>/, keeping its path
displace() {
  local dest="$1" stamp="$2" aside

  aside="$displaced/$stamp/${dest#"$HOME"/}"
  mkdir -p "$(dirname "$aside")"
  /bin/mv -n "$dest" "$aside"

  # Moved only if it's gone from where it was and arrived where it's going
  ! occupied "$dest" && occupied "$aside"
}

# Add a value to a space-separated setting in rcrc, unless it, or a pattern
# matching it, is already there. Rewrites the file in place, so ~/.rcrc keeps
# pointing at it.
rcrc_add() {
  local key="$1" value="$2" line list pattern covered found=0 tmp
  local -a patterns

  tmp="$(mktemp)"

  while IFS= read -r line || [ -n "$line" ]; do
    if [[ $line == "$key=\""*\" ]]; then
      found=1
      list="${line#"$key=\""}"
      list="${list%\"}"
      read -r -a patterns <<< "$list"
      covered=0

      for pattern in ${patterns[@]+"${patterns[@]}"}; do
        # Unquoted on the right, so rcrc's own patterns match as patterns
        if [[ $value == $pattern ]]; then
          covered=1
        fi
      done

      if [ "$covered" -eq 0 ]; then
        list="${list:+$list }$value"
      fi

      line="$key=\"$list\""
    fi

    printf '%s\n' "$line"
  done < "$rcrc" > "$tmp"

  if [ "$found" -eq 0 ]; then
    printf '%s="%s"\n' "$key" "$value" >> "$tmp"
  fi

  cat "$tmp" > "$rcrc"
  rm -f "$tmp"
}

cmd_add() {
  local undotted=0 copy=0 dry_run=0 file abs rel repo_rel stored kind
  local -a files=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --undotted|-U) undotted=1 ;;
      --copy|-C) copy=1 ;;
      --dry-run|-n) dry_run=1 ;;
      -h|--help) help; exit 0 ;;
      -*) die "add: unknown option $1 (see rc help)" ;;
      *) files+=("$1") ;;
    esac
    shift
  done

  if [ ${#files[@]} -eq 0 ]; then
    die "add: name at least one file (see rc help)"
  fi

  # Check every file before changing anything
  for file in "${files[@]}"; do
    abs="$(absolute "$file")"
    rel="${abs#"$HOME"/}"

    if [ "$rel" = "$abs" ]; then
      die "add: $file isn't inside your home folder"
    elif [ -L "$abs" ]; then
      die "add: $(shown "$abs") is a link already; nothing to add"
    elif [ -d "$abs" ]; then
      die "add: $(shown "$abs") is a folder; add the files in it instead"
    elif [ ! -f "$abs" ]; then
      die "add: $(shown "$abs") doesn't exist"
    elif [[ $abs == "$repo"/* ]]; then
      die "add: $(shown "$abs") is inside ~/.dotfiles already"
    fi

    # Dotted files go in the repo without their dot; undotted ones as-is
    if [ "$undotted" -eq 1 ]; then
      repo_rel="$rel"
    elif [[ $rel == .* ]]; then
      repo_rel="${rel#.}"
    else
      die "add: $(shown "$abs") has no leading dot; use --undotted"
    fi

    if occupied "$repo/$repo_rel"; then
      die "add: ~/.dotfiles/$repo_rel exists already; not overwriting it"
    fi
  done

  kind="@"

  if [ "$copy" -eq 1 ]; then
    kind="X"
  fi

  for file in "${files[@]}"; do
    abs="$(absolute "$file")"
    rel="${abs#"$HOME"/}"

    if [ "$undotted" -eq 1 ]; then
      repo_rel="$rel"
    else
      repo_rel="${rel#.}"
    fi

    stored="$repo/$repo_rel"

    if [ "$dry_run" -eq 1 ]; then
      item + "would move $(shown "$abs") to ~/.dotfiles/$repo_rel and $([ "$copy" -eq 1 ] && echo "copy" || echo "link") it back"
    else
      # Into the repo, without replacing anything
      mkdir -p "$(dirname "$stored")"
      /bin/mv -n "$abs" "$stored"

      if occupied "$abs" || ! occupied "$stored"; then
        die "add: couldn't move $(shown "$abs") into the repo; nothing changed for it"
      fi

      # Back into place; the spot is empty, since the file just left it
      if ! install_one "$stored" "$abs" "$kind"; then
        die "add: moved $(shown "$abs") to ~/.dotfiles/$repo_rel, but couldn't put it back; run rc link"
      fi

      item + "added $(shown "$abs") as ~/.dotfiles/$repo_rel"
    fi

    # Record undotted and copied paths in rcrc, so `rc link` installs them
    # the same way later
    if [ "$undotted" -eq 1 ]; then
      if [ "$dry_run" -eq 1 ]; then
        item "~" "would add ${repo_rel%%/*} to UNDOTTED in rcrc"
      else
        rcrc_add UNDOTTED "${repo_rel%%/*}"
      fi
    fi

    if [ "$copy" -eq 1 ]; then
      if [ "$dry_run" -eq 1 ]; then
        item "~" "would add $repo_rel to COPY_ALWAYS in rcrc"
      else
        rcrc_add COPY_ALWAYS "$repo_rel"
      fi
    fi
  done
}

cmd_link() {
  local dry_run=0 force=0 dest src kind entry action stamp ok=0 added=0
  local -a new=() stale=() conflicts=() failed=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run|-n) dry_run=1 ;;
      --force|-f) force=1 ;;
      -h|--help) help; exit 0 ;;
      *) die "link: unknown argument $1 (see rc help)" ;;
    esac
    shift
  done

  # Sort everything rcm manages into in place, new, and in the way
  while IFS=: read -r dest src kind; do
    case "$(link_state "$dest" "$src" "$kind")" in
      ok) ok=$((ok + 1)) ;;
      new) new+=("$kind:$src:$dest") ;;
      stale) stale+=("$kind:$src:$dest") ;;
      conflict) conflicts+=("$kind:$src:$dest") ;;
    esac
  done < <(lsrc -F)

  stamp="$(date +%Y-%m-%d-%H%M%S)"

  # Copies that are just out of date (git has the old version): update them,
  # still moving the old one aside rather than overwriting it
  for entry in ${stale[@]+"${stale[@]}"}; do
    IFS=: read -r kind src dest <<< "$entry"

    if [ "$dry_run" -eq 1 ]; then
      item "~" "would update copy $(shown "$dest") (unchanged here; the repo has a newer version)"
    elif displace "$dest" "$stamp" && install_one "$src" "$dest" "$kind"; then
      item "~" "updated copy $(shown "$dest"); the old one is in $(shown "$displaced/$stamp")/"
      reload_hint "$dest"
      added=$((added + 1))
    else
      item x "couldn't update copy $(shown "$dest"); check $(shown "$displaced/$stamp")/"
      failed+=("$dest")
    fi
  done

  gap

  for entry in ${new[@]+"${new[@]}"}; do
    IFS=: read -r kind src dest <<< "$entry"
    action="link"

    if [ "$kind" = "X" ]; then
      action="copy"
    fi

    if [ "$dry_run" -eq 1 ]; then
      item + "would $action $(shown "$dest")"
    elif install_one "$src" "$dest" "$kind"; then
      item + "$action $(shown "$dest")"
      reload_hint "$dest"
      added=$((added + 1))
    else
      item x "couldn't $action $(shown "$dest")"
      failed+=("$dest")
    fi
  done

  gap

  for entry in ${conflicts[@]+"${conflicts[@]}"}; do
    IFS=: read -r kind src dest <<< "$entry"

    if [ "$force" -eq 0 ]; then
      item ! "skip $(shown "$dest"): something else is there"
    elif [ "$dry_run" -eq 1 ]; then
      item ! "would move $(shown "$dest") to $(shown "$displaced/$stamp")/ and replace it"
    elif ! displace "$dest" "$stamp"; then
      item x "couldn't move $(shown "$dest") aside; left it alone"
      failed+=("$dest")
    elif install_one "$src" "$dest" "$kind"; then
      item ! "moved $(shown "$dest") to $(shown "$displaced/$stamp")/ and replaced it"
      added=$((added + 1))
    else
      item x "moved $(shown "$dest") aside but couldn't replace it; it's in $(shown "$displaced/$stamp")/"
      failed+=("$dest")
    fi
  done

  gap

  if [ "$dry_run" -eq 1 ]; then
    out "$blue$icon_heading$reset ${bold}Dry run:$reset $(tally ${#new[@]} "to add" "$green"), $(tally ${#stale[@]} "to update" "$cyan"), $(tally ${#conflicts[@]} "in the way" "$yellow"), $ok already in place"
    return
  fi

  if [ "$force" -eq 1 ]; then
    out "$blue$icon_heading$reset ${bold}Done:$reset $(tally "$added" "added" "$green"), $(tally ${#failed[@]} "failed" "$red"), $ok already in place"
  else
    out "$blue$icon_heading$reset ${bold}Done:$reset $(tally "$added" "added" "$green"), $(tally ${#conflicts[@]} "in the way" "$yellow"), $(tally ${#failed[@]} "failed" "$red"), $ok already in place"
  fi

  if [ "$force" -eq 0 ] && [ ${#conflicts[@]} -gt 0 ]; then
    out "Nothing in the way was touched. Move it aside yourself, or use ${bold}rc link --force$reset to move it to ~/.rc-displaced/."
  fi

  if [ ${#failed[@]} -gt 0 ]; then
    exit 1
  fi
}

cmd_unlink() {
  local dry_run=0 file abs target
  local -a files=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run|-n) dry_run=1 ;;
      -h|--help) help; exit 0 ;;
      -*) die "unlink: unknown option $1 (see rc help)" ;;
      *) files+=("$1") ;;
    esac
    shift
  done

  # rcm's rcdn with no files removes everything; rc doesn't offer that
  if [ ${#files[@]} -eq 0 ]; then
    die "unlink: name the links to remove (see rc help)"
  fi

  for file in "${files[@]}"; do
    abs="$(absolute "$file")"

    if [ ! -L "$abs" ]; then
      item ! "skip $(shown "$abs"): not a link, and rc never removes files"
      continue
    fi

    target="$(readlink "$abs")"

    if [[ $target != "$repo"/* ]]; then
      item ! "skip $(shown "$abs"): links to $(shown "$target"), not into ~/.dotfiles"
      continue
    fi

    if [ "$dry_run" -eq 1 ]; then
      item - "would remove link $(shown "$abs")"
    else
      rm "$abs"
      item - "removed link $(shown "$abs") (the next rc link puts it back)"
    fi
  done
}

cmd_rename() {
  local dry_run=0 file="" new_name="" abs dest="" src="" kind="" d s k
  local rel new_src new_dest new_rel key list pattern found
  local -a args=() patterns=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run|-n) dry_run=1 ;;
      -h|--help) help; exit 0 ;;
      -*) die "rename: unknown option $1 (see rc help)" ;;
      *) args+=("$1") ;;
    esac
    shift
  done

  if [ ${#args[@]} -ne 2 ]; then
    die "rename: give the file and its new name, e.g. rc rename ~/.bin/foo bar"
  fi

  file="${args[0]}"
  new_name="${args[1]}"

  # A plain new name: same folder, so dotting and rcrc's folder rules can't change
  if [[ $new_name == */* ]] || [ -z "$new_name" ] || [ "$new_name" = "." ] || [ "$new_name" = ".." ]; then
    die "rename: the new name must be a plain file name, not a path; rename only works within a folder"
  fi

  abs="$(absolute "$file")"

  # Find the file in rcm's list, by its place in ~ or in the repo
  while IFS=: read -r d s k; do
    if [ "$d" = "$abs" ] || [ "$s" = "$abs" ]; then
      dest="$d"
      src="$s"
      kind="$k"
    fi
  done < <(lsrc -F)

  if [ -z "$src" ]; then
    die "rename: $(shown "$abs") isn't a file rc manages (see rc ls)"
  fi

  rel="${src#"$repo"/}"
  new_src="$(dirname "$src")/$new_name"
  new_dest="$(dirname "$dest")/$new_name"
  new_rel="${new_src#"$repo"/}"

  if [ "$new_src" = "$src" ]; then
    die "rename: that's its name already"
  fi

  # Copies need care (a LaunchAgent has to be unloaded first); do those by hand
  if [ "$kind" != "@" ]; then
    die "rename: $(shown "$dest") is installed as a copy, not a link; rename it by hand"
  fi

  # The file in the repo: a real file, committed, so git has its contents
  if [ -L "$src" ] || [ ! -f "$src" ]; then
    die "rename: ~/.dotfiles/$rel isn't a plain file"
  fi

  if ! git -C "$repo" ls-files --error-unmatch -- "$rel" > /dev/null 2>&1; then
    die "rename: ~/.dotfiles/$rel isn't committed to git yet; commit it first"
  fi

  # rcrc rules that name either path would change how it's installed
  for key in UNDOTTED COPY_ALWAYS EXCLUDES; do
    list="$(sed -n "s/^$key=\"\(.*\)\"$/\1/p" "$rcrc")"
    read -r -a patterns <<< "$list"

    for pattern in ${patterns[@]+"${patterns[@]}"}; do
      # Unquoted on the right, so rcrc's own patterns match as patterns
      if [[ $rel == $pattern ]] || [[ $new_rel == $pattern ]] || [[ ${rel%%/*} == $pattern ]]; then
        die "rename: rcrc's $key mentions this file ($pattern); rename it by hand and update rcrc"
      fi
    done
  done

  # The link in ~: exactly the right link, or not there at all
  found="$(link_state "$dest" "$src" "$kind")"

  if [ "$found" = "conflict" ]; then
    die "rename: $(shown "$dest") isn't the link rc expects; sort it out first (rc link -n shows it)"
  fi

  # Nothing at all at either new path, in the repo or in ~
  if occupied "$new_src"; then
    die "rename: ~/.dotfiles/$new_rel exists already; not overwriting it"
  fi

  if occupied "$new_dest"; then
    die "rename: $(shown "$new_dest") exists already; not overwriting it"
  fi

  # Uncommitted edits travel with the file; say so
  if ! git -C "$repo" diff --quiet -- "$rel" || ! git -C "$repo" diff --cached --quiet -- "$rel"; then
    out "$yellow$icon_note$reset ~/.dotfiles/$rel has uncommitted changes; they move with it"
  fi

  gap

  if [ "$dry_run" -eq 1 ]; then
    item "~" "would git mv ~/.dotfiles/$rel to ~/.dotfiles/$new_rel"
    item + "would link $(shown "$new_dest")"

    if [ "$found" = "ok" ]; then
      item - "would remove the old link $(shown "$dest")"
    fi

    return
  fi

  # 1. Rename in the repo; git refuses if the new path exists
  if ! git -C "$repo" mv -- "$rel" "$new_rel" || occupied "$src" || [ ! -f "$new_src" ]; then
    die "rename: git mv failed; check git status in ~/.dotfiles"
  fi

  item "~" "renamed ~/.dotfiles/$rel to ~/.dotfiles/$new_rel (git mv)"

  # 2. The new link; on failure, undo step 1 so nothing is left half done
  if ! install_one "$new_src" "$new_dest" "@"; then
    if git -C "$repo" mv -- "$new_rel" "$rel" && [ -f "$src" ]; then
      die "rename: couldn't link $(shown "$new_dest"); undid the rename, so nothing changed"
    fi

    die "rename: couldn't link $(shown "$new_dest"), and couldn't undo the rename; check git status in ~/.dotfiles"
  fi

  item + "linked $(shown "$new_dest")"

  # 3. The old link, now broken: only if it's still exactly that link
  if [ "$found" = "ok" ]; then
    if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ] && [ ! -e "$dest" ]; then
      rm "$dest"
      item - "removed the old link $(shown "$dest")"
    else
      item ! "left $(shown "$dest") alone: it changed during the rename; rc prune cleans up a broken link"
    fi
  fi

  gap
  out "$green${bold}done.$reset The rename is staged in git; commit it when ready. Run ${bold}rehash$reset so zsh sees the new name."
}

cmd_prune() {
  local dry_run=0 link target count=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run|-n) dry_run=1 ;;
      -h|--help) help; exit 0 ;;
      *) die "prune: unknown argument $1 (see rc help)" ;;
    esac
    shift
  done

  # Broken links into the repo, skipping big folders that never hold any
  while IFS= read -r link; do
    target="$(readlink "$link")"

    if [[ $target != "$repo"/* ]] || [ -e "$link" ]; then
      continue
    fi

    count=$((count + 1))

    if [ "$dry_run" -eq 1 ]; then
      item - "would remove broken link $(shown "$link")"
    else
      rm "$link"
      item - "removed broken link $(shown "$link")"
    fi
  done < <(find "$HOME" -maxdepth 4 \
    \( -path "$HOME/Library" -o -path "$HOME/.Trash" -o -path "$repo" \
       -o -path "$displaced" -o -path "$HOME/Code" -o -path "$HOME/Movies" \
       -o -path "$HOME/Music" -o -path "$HOME/Pictures" -o -path "$HOME/Videos" \
       -o -path "$HOME/.cache" -o -path "$HOME/.npm" -o -path "$HOME/.cargo" \
       -o -path "$HOME/.rustup" -o -path "$HOME/.rbenv" -o -path "$HOME/.gem" \
       -o -path "$HOME/.zinit" -o -path "$HOME/Desktop" \
       -o -path "$HOME/Documents" -o -path "$HOME/Downloads" \) -prune \
    -o -type l -print 2>/dev/null)

  if [ "$count" -eq 0 ]; then
    out "${green}no broken links$reset"
  fi
}

cmd_sync() {
  local dry_run=0 upstream

  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run|-n) dry_run=1 ;;
      -h|--help) help; exit 0 ;;
      *) die "sync: unknown argument $1 (see rc help)" ;;
    esac
    shift
  done

  upstream="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)" ||
    die "sync: the current branch has no remote branch to pull from"

  git -C "$repo" fetch --quiet

  if [ "$dry_run" -eq 1 ]; then
    heading "Incoming from $upstream"
    git -C "$repo" log --oneline "HEAD..@{u}"
    gap
    out "(run rc sync to pull these, then link and prune)"
    return
  fi

  # Fast-forward only: git refuses rather than merge, or touch files with
  # uncommitted changes
  if ! git -C "$repo" merge --ff-only --quiet "@{u}"; then
    die "sync: couldn't fast-forward to $upstream; nothing was linked. Sort out the repo first (git status)."
  fi

  cmd_link
  gap
  cmd_prune
}

case "${1:-}" in
  add) shift; cmd_add "$@" ;;
  sync) shift; cmd_sync "$@" ;;
  link) shift; cmd_link "$@" ;;
  unlink) shift; cmd_unlink "$@" ;;
  rename) shift; cmd_rename "$@" ;;
  prune) shift; cmd_prune "$@" ;;
  ls) shift; lsrc "$@"; list_end ;;
  help|-h|--help) help ;;
  "") help; exit 1 ;;
  *) err "$red$bold$icon_error$reset unknown command $1"; gap; help >&2; exit 1 ;;
esac
