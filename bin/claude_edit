#!/usr/bin/env python3
"""Claude Code's external editor (Ctrl-G), in a tmux pane, with context.

Claude Code calls its editor with one argument, a temporary markdown file
holding the draft prompt, and reads the file back when the editor exits.
This wrapper:

  1. Puts Claude's last message above the draft, re-wrapped to 80 columns,
     then a marker line. Everything down to the marker is removed again
     after vim exits, so only the reply is sent.
  2. Opens vim in the pane below Claude's instead of in Claude's own pane,
     with the cursor on the reply. Whatever was in that pane (a terminal,
     say) waits in a window named "parked" and comes back when vim exits,
     and focus returns to Claude.

The pane vim takes over is the one named by the window option
@claude_edit_pane (set with the pane-number overlay; see tmux.conf), else
the pane directly below Claude's. With neither, vim gets a new split below
Claude. Outside tmux, vim runs in place.

Set it for Claude Code only, in ~/.claude/settings.json:

    "env": { "EDITOR": "~/.bin/claude_edit" }

Environment:
  CLAUDE_EDIT_VIM         the editor to run (default: vim)
  CLAUDE_EDIT_TRANSCRIPT  a transcript to read, skipping the lookup
"""
import glob
import json
import os
import shlex
import shutil
import subprocess
import sys
import time

MARKER = ('<!-- Reply below this line. '
          'It and everything above are removed on save. -->')
BUILTIN = 'Write your reply below this line'
HOME = os.path.expanduser('~/.claude')
WIDTH = 80
# Columns a pane needs beyond the text, for vim's line numbers.
GUTTER = 6


def run(*args):
    r = subprocess.run(args, capture_output=True, text=True)
    return r.stdout.strip()


def session_id():
    """Session of the Claude Code process this editor was started by."""
    pid = os.getppid()
    while pid > 1:
        try:
            with open(f'{HOME}/sessions/{pid}.json') as f:
                return json.load(f).get('sessionId')
        except (OSError, ValueError):
            pid = int(run('ps', '-o', 'ppid=', '-p', str(pid)) or 0)
    return None


def transcript():
    path = os.environ.get('CLAUDE_EDIT_TRANSCRIPT')
    if path:
        return path
    sid = session_id()
    found = glob.glob(f'{HOME}/projects/*/{sid}.jsonl') if sid else []
    return found[0] if found else None


def last_message(path):
    """Text of the last message Claude addressed to the user."""
    text = ''
    try:
        with open(path) as f:
            for line in f:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                if row.get('type') != 'assistant' or row.get('isSidechain'):
                    continue
                content = (row.get('message') or {}).get('content')
                if not isinstance(content, list):
                    continue
                parts = [c.get('text', '') for c in content
                         if c.get('type') == 'text']
                if ''.join(parts).strip():
                    text = '\n\n'.join(parts).strip()
    except OSError:
        pass
    return text


def wrap(text, columns):
    """Re-wrap markdown to fit; unchanged if pandoc is missing."""
    if not shutil.which('pandoc'):
        return text
    r = subprocess.run(
        ['pandoc', '-f', 'gfm', '-t', 'gfm', f'--columns={columns}'],
        input=text, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 and r.stdout else text


def panes(window):
    """Tiled panes of a window: id -> (left, top, width, height)."""
    fmt = ('#{pane_id} #{pane_floating_flag} #{pane_left} #{pane_top} '
           '#{pane_width} #{pane_height}')
    found = {}
    for row in run('tmux', 'list-panes', '-t', window, '-F', fmt).split('\n'):
        pid, floating, *box = row.split()
        if floating != '1':
            found[pid] = tuple(map(int, box))
    return found


def slot(own):
    """The pane the editor takes over, and the width it will have.

    That is the pane named by @claude_edit_pane, else the pane directly
    below Claude's. With neither, the pane is None and the editor gets a
    new split, as wide as Claude's pane.
    """
    window = run('tmux', 'display', '-p', '-t', own, '#{window_id}')
    found = panes(window)
    left, top, width, height = found[own]
    target = run('tmux', 'show', '-wqv', '-t', own, '@claude_edit_pane')
    if target and target != own and target in found:
        return target, found[target][2]
    best, most = None, 0
    for pid, (x, y, w, _) in found.items():
        # One row down from Claude's pane, past the border between them.
        shared = min(x + w, left + width) - max(x, left)
        if y == top + height + 1 and shared > most:
            best, most = pid, shared
    return best, found[best][2] if best else width


def alive():
    """Every pane on the server: id -> True while its program runs."""
    rows = run('tmux', 'list-panes', '-a', '-F',
               '#{pane_id} #{pane_dead}').split('\n')
    return {r.split()[0]: r.split()[1] == '0' for r in rows if r}


def edit(path, line, own, place, columns):
    vim = shlex.split(os.environ.get('CLAUDE_EDIT_VIM', 'vim'))
    # Wrap at the pane's width, in view and while typing, so a narrow pane
    # never scrolls sideways. zb: the reply at the bottom, as much of the
    # message above as fits.
    cmd = vim + [f'+setlocal wrap linebreak textwidth={columns}',
                 f'+call cursor({line}, 1)', '+normal! zb', path]
    if not place:
        subprocess.run(cmd)
        return
    target = place[0]
    made = ['-P', '-F', '#{pane_id}', '-c', os.getcwd(), shlex.join(cmd)]
    if target:
        # Start vim in a window of its own, then trade places with the
        # target: vim lands in the target's exact spot, no pane changes
        # size, and the target waits in that window until vim is done.
        pane = run('tmux', 'new-window', '-d', '-n', 'parked', *made)
        run('tmux', 'set', '-p', '-t', pane, 'remain-on-exit', 'on')
        run('tmux', 'swap-pane', '-d', '-s', pane, '-t', target)
    else:
        pane = run('tmux', 'split-window', '-v', '-l', '40%', '-t', own,
                   *made)
    if not pane:
        subprocess.run(cmd)
        return
    run('tmux', 'select-pane', '-t', pane)
    # Claude Code waits on this process, so wait on vim's pane.
    while alive().get(pane):
        time.sleep(0.1)
    if target and target in alive():
        if pane in alive():
            run('tmux', 'swap-pane', '-d', '-s', target, '-t', pane)
        else:
            # vim's pane was killed outright: bring the target home.
            run('tmux', 'join-pane', '-d', '-v', '-s', target, '-t', own)
    run('tmux', 'kill-pane', '-t', pane)
    run('tmux', 'select-pane', '-t', own)


def main():
    # EDITOR set for Claude Code also reaches what it runs, such as git.
    # Anything but a Claude prompt file gets plain vim.
    name = os.path.basename(sys.argv[-1]) if len(sys.argv) == 2 else ''
    if not (name.startswith('claude-prompt-') and name.endswith('.md')):
        os.execvp('vim', ['vim', *sys.argv[1:]])
    path = sys.argv[1]
    with open(path) as f:
        draft = f.read()
    # With externalEditorContext on, the draft arrives under Claude Code's
    # own block of `#` lines. Set it aside, and hand it back untouched so
    # Claude Code can strip it as usual.
    own_block = ''
    lines = draft.split('\n')
    for i, text in enumerate(lines):
        if text.startswith('#') and BUILTIN in text:
            own_block = '\n'.join(lines[:i + 1]) + '\n\n'
            draft = '\n'.join(lines[i + 1:]).lstrip('\n')
            break
    own = os.environ.get('TMUX_PANE')
    place = slot(own) if os.environ.get('TMUX') and own else None
    # A narrow pane gets narrower text, so nothing runs off its edge.
    columns = min(WIDTH, place[1] - GUTTER) if place else WIDTH
    source = transcript()
    quote = wrap(last_message(source), max(columns, 30)) if source else ''
    line = 1
    if quote:
        head = f'{quote}\n\n{MARKER}\n\n'
        line = head.count('\n') + 1
        with open(path, 'w') as f:
            f.write(head + draft)
    elif own_block:
        with open(path, 'w') as f:
            f.write(draft)
    edit(path, line, own, place, columns)
    with open(path) as f:
        body = f.read()
    if quote and MARKER in body:
        body = body.split(MARKER, 1)[1].lstrip('\n')
    if quote or own_block:
        with open(path, 'w') as f:
            f.write(own_block + body)


if __name__ == '__main__':
    main()
