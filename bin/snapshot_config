#!/usr/bin/env bash
# Copy a config file that an app rewrites on its own (so it can't be a
# symlink) into the dotfiles repo, and commit just that file. Run by launchd
# whenever the file's folder changes; see Library/LaunchAgents/ in the repo.
#
# The copy starts with a header saying how to restore it. For most files
# that's a // comment block, so restoring means dropping everything through
# the header's last line, which the header itself spells out. With --plist,
# a binary plist is saved as XML (so it diffs) and the header is an XML
# comment, so the copy stays a valid plist.
#
# --defaults DOMAIN reads an app's preferences through `defaults export`
# (implies --plist; <file> is the domain's plist, used only for its date).
# Restoring is `defaults import`, which merges: keys left out stay as they are.
# --drop REGEX leaves out top-level keys that match, for noise (window frames,
# update checks) and anything private (licenses).
#
# Commits always go to main (SNAPSHOT_BRANCH), even while a feature branch
# is checked out, so a snapshot never lands in the middle of other work.
#
# --keychain names a Keychain item (by service) whose value must never be
# committed. The repo is public: if any listed value turns up in the copy,
# nothing is written or committed, and a notification says why.
#
# Usage: snapshot_config [--plist | --defaults DOMAIN] [--drop REGEX]
#          [--keychain SERVICE]... <file> <path inside the repo>

set -euo pipefail

plist=0
domain=""
drop=""
keychain=()

while [ $# -gt 0 ]; do
  case "$1" in
    --plist) plist=1 ;;
    --defaults) plist=1; domain="$2"; shift ;;
    --drop) drop="$2"; shift ;;
    --keychain) keychain+=("$2"); shift ;;
    *) break ;;
  esac
  shift
done

src="$1"
rel="$2"
repo="${DOTFILES:-$HOME/.dotfiles}"
# Snapshots are always committed here, never to a feature branch
branch="${SNAPSHOT_BRANCH:-main}"
dest="$repo/$rel"
name="$(basename "$src")"
end_marker="// end of backup header"

# Paths as they'd be typed, with ~ for the home folder
src_shown="${src/#"$HOME"/\~}"
dest_shown="${dest/#"$HOME"/\~}"

notify() {
  osascript -e "display notification \"$1\" with title \"Snapshot: $name\""
}

# Cheap exit first: launchd runs this on every change in the watched folder,
# which for some apps is every time they're used. Nothing to do unless the
# file is newer than the last snapshot (a checked copy is touched below).
if [ -f "$dest" ] && [ ! "$src" -nt "$dest" ]; then
  exit 0
fi

tmp="$dest.tmp"
mkdir -p "$(dirname "$dest")"

if [ "$plist" -eq 1 ]; then
  if [ -n "$domain" ]; then
    xml="$(defaults export "$domain" -)"
    restore="defaults import $domain '$dest_shown'"
    what="the $domain preferences"
  else
    xml="$(plutil -convert xml1 -o - "$src")"
    restore="plutil -convert binary1 -o '$src_shown' '$dest_shown'"
    what="$src_shown"
  fi

  # Leave out keys matching --drop
  if [ -n "$drop" ]; then
    xml="$(/usr/bin/python3 -c '
import plistlib, re, sys
d = plistlib.loads(sys.stdin.buffer.read())
d = {k: v for k, v in d.items() if not re.search(sys.argv[1], k)}
sys.stdout.buffer.write(plistlib.dumps(d))
' "$drop" <<< "$xml")"
  fi

  {
    head -n 1 <<< "$xml"
    echo "<!--"
    echo "  Backup of $what, saved as XML by"
    echo "  ~/.dotfiles/bin/snapshot_config every time the app rewrites it."

    if [ -n "$drop" ]; then
      echo "  Keys matching $drop are left out."
    fi

    echo ""
    echo "  This file is still a valid plist. To restore, quit the app first, then:"
    echo ""
    echo "    $restore"
    echo "-->"
    tail -n +2 <<< "$xml"
  } > "$tmp"
else
  {
    echo "// Backup of $src_shown, saved by ~/.dotfiles/bin/snapshot_config"
    echo "// every time the app rewrites it."
    echo "//"
    echo "// To restore: copy this file over $src_shown and delete this"
    echo "// header block, through the end-of-header line below, so only the"
    echo "// original file is left. One command does both:"
    echo "//"
    echo "//   sed '1,\\|^$end_marker\$|d' $dest_shown > $src_shown"
    echo "//"
    echo "$end_marker"
    cat "$src"
  } > "$tmp"
fi

# Whether the snapshot branch has the copy committed as it is now
committed() {
  local have
  have="$(git -C "$repo" rev-parse -q --verify "$branch:$rel")" &&
    [ "$have" = "$(git -C "$repo" hash-object -- "$dest")" ]
}

# Commit the copy to the snapshot branch while another branch is checked
# out, without touching that branch, the index or any other file: build
# the commit from the snapshot branch's tree with this one file replaced,
# then move the branch to it, provided nothing else moved it meanwhile.
commit_elsewhere() {
  local index="$repo/.git/snapshot_config.index" blob tree old new
  rm -f "$index"
  old="$(git -C "$repo" rev-parse --verify "refs/heads/$branch")" &&
    blob="$(git -C "$repo" hash-object -w -- "$dest")" &&
    GIT_INDEX_FILE="$index" git -C "$repo" read-tree "$old" &&
    GIT_INDEX_FILE="$index" git -C "$repo" update-index --add \
      --cacheinfo "100644,$blob,$rel" &&
    tree="$(GIT_INDEX_FILE="$index" git -C "$repo" write-tree)" &&
    new="$(git -C "$repo" commit-tree -S -p "$old" -m "Snapshot $name" \
      "$tree")" &&
    git -C "$repo" update-ref "refs/heads/$branch" "$new" "$old"
  local status=$?
  rm -f "$index"
  return $status
}

# The header never changes, so an identical, committed copy means nothing to
# do. Touching it lets the cheap exit above skip this file until it changes.
if [ -f "$dest" ] && cmp -s "$tmp" "$dest" && committed; then
  rm -f "$tmp"
  touch "$dest"
  exit 0
fi

# Never commit a listed secret. A refusal touches the old copy (if any), so it
# warns once per change instead of on every run.
for service in ${keychain[@]+"${keychain[@]}"}; do
  secret="$(security find-generic-password -s "$service" -w 2>/dev/null || true)"

  if [ -z "$secret" ]; then
    rm -f "$tmp"
    [ -f "$dest" ] && touch "$dest"
    notify "Couldn't read the Keychain item '$service' to check for it; nothing committed"
    exit 1
  fi

  if grep -qF -- "$secret" "$tmp"; then
    rm -f "$tmp"
    [ -f "$dest" ] && touch "$dest"
    notify "The value of the Keychain item '$service' is in the file; nothing committed"
    exit 1
  fi
done

mv -f "$tmp" "$dest"

# One snapshot commits at a time: several agents can fire at once, and git's
# index is shared. mkdir is atomic; a lock older than a minute is left over
# from a run that died, so take it over.
lock="$repo/.git/snapshot_config.lock"

for _ in $(seq 60); do
  if mkdir "$lock" 2>/dev/null; then
    trap 'rmdir "$lock" 2>/dev/null' EXIT
    break
  fi

  if [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
    rmdir "$lock" 2>/dev/null || true
    continue
  fi

  sleep 0.5
done

# Commit only this file, leaving anything else staged alone. James may be
# using git at the same moment, so wait out a held git lock for up to 10
# seconds. Any other failure (no signing key unlocked, a rebase in
# progress) leaves the copy for a manual commit and says so; backdating it
# makes the next run try again instead of taking the cheap exit.
#
# Snapshots belong to the snapshot branch, whatever is checked out. On a
# feature branch the copy then shows as modified until that branch is
# rebased onto the snapshot branch, which already has it.
for _ in $(seq 20); do
  if [ "$(git -C "$repo" symbolic-ref -q --short HEAD)" = "$branch" ]; then
    out="$(git -C "$repo" add -- "$rel" 2>&1 &&
      git -C "$repo" commit -q -m "Snapshot $name" -- "$rel" 2>&1)" && exit 0
  else
    out="$(commit_elsewhere 2>&1)" && exit 0
  fi

  case "$out" in
    *.lock*|*"cannot lock"*) sleep 0.5 ;;
    *) break ;;
  esac
done

touch -t 200001010000 "$dest"
notify "Copied into the repo, but the commit failed"
exit 1
