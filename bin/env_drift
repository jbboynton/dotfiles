#!/usr/bin/env zsh
# Compare hard-coded environment settings with what their tools report now.
# Prints one line per problem, and nothing when everything matches. Started
# in the background by zsh/drift.zsh; reads the calling shell's environment,
# plus its fpath in FPATH_CHECK.

problems=()

# Homebrew: run `brew shellenv` in a clean shell and compare with ours
brew="$HOMEBREW_PREFIX/bin/brew"

if [[ ! -x $brew ]]; then
  problems+=("brew not found at $brew")
else
  expected=$(env -i HOME=$HOME /bin/zsh -fc '
    eval "$("$1" shellenv)" || exit 1
    prefix=$HOMEBREW_PREFIX
    print -r -- "var HOMEBREW_PREFIX $HOMEBREW_PREFIX"
    print -r -- "var HOMEBREW_CELLAR $HOMEBREW_CELLAR"
    print -r -- "var HOMEBREW_REPOSITORY $HOMEBREW_REPOSITORY"
    for d in ${(M)path:#$prefix/*}; do print -r -- "dir PATH $d"; done
    for d in ${(M)${(s.:.)MANPATH}:#$prefix/*}; do print -r -- "dir MANPATH $d"; done
    for d in ${(M)${(s.:.)INFOPATH}:#$prefix/*}; do print -r -- "dir INFOPATH $d"; done
    for d in ${(M)fpath:#$prefix/*}; do print -r -- "dir FPATH_CHECK $d"; done
  ' zsh "$brew")

  if (( $? != 0 )); then
    problems+=("brew shellenv failed")
  fi

  for kind name value in ${=expected}; do
    if [[ $kind == var && ${(P)name} != $value ]]; then
      problems+=("$name is '${(P)name}', brew says '$value'")
    elif [[ $kind == dir && ":${(P)name}:" != *":$value:"* ]]; then
      problems+=("$value missing from ${name/FPATH_CHECK/fpath}")
    fi
  done
fi

# batman: its --export-env output, compared with MANPAGER and MANROFFOPT
batman="$HOME/.local/bin/batman"

if [[ ! -x $batman ]]; then
  problems+=("batman not installed at $batman")
else
  expected=("${(@f)$(env -i HOME=$HOME PATH=$PATH /bin/zsh -fc '
    eval "$("$1" --export-env)" || exit 1
    print -r -- "$MANPAGER"
    print -r -- "$MANROFFOPT"
  ' zsh "$batman")}")

  if [[ $expected[1] != $MANPAGER ]]; then
    problems+=("MANPAGER is '$MANPAGER', batman says '$expected[1]'")
  fi

  if [[ $expected[2] != $MANROFFOPT ]]; then
    problems+=("MANROFFOPT is '$MANROFFOPT', batman says '$expected[2]'")
  fi
fi

print -rl -- $problems
(( $#problems == 0 ))
