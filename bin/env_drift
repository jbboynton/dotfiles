#!/usr/bin/env zsh
# Compare hard-coded environment settings with what their tools report now.
# Prints one line per problem, and nothing when everything matches. Started
# in the background by zsh/drift.zsh; reads the calling shell's environment,
# plus its fpath in FPATH_CHECK.

problems=()

# Homebrew: run `brew shellenv` in a clean shell and compare with ours
brew="$HOMEBREW_PREFIX/bin/brew"

if [[ ! -x $brew ]]; then
  problems+=("brew not found at $brew; HOMEBREW_PREFIX is set by brew_env in ~/.dotfiles/zprofile")
else
  expected=$(env -i HOME=$HOME /bin/zsh -fc '
    eval "$("$1" shellenv)" || exit 1
    prefix=$HOMEBREW_PREFIX
    print -r -- "var HOMEBREW_PREFIX $HOMEBREW_PREFIX"
    print -r -- "var HOMEBREW_CELLAR $HOMEBREW_CELLAR"
    print -r -- "var HOMEBREW_REPOSITORY $HOMEBREW_REPOSITORY"
    for d in ${(M)path:#$prefix/*}; do print -r -- "dir PATH $d"; done
    for d in ${(M)${(s.:.)MANPATH}:#$prefix/*}; do print -r -- "dir MANPATH $d"; done
    for d in ${(M)${(s.:.)INFOPATH}:#$prefix/*}; do print -r -- "dir INFOPATH $d"; done
    if [[ -n $2 ]]; then
      for d in ${(M)fpath:#$prefix/*}; do print -r -- "dir FPATH_CHECK $d"; done
    fi
  ' zsh "$brew" "${FPATH_CHECK:-}")

  if (( $? != 0 )); then
    problems+=("brew shellenv failed; run \`brew shellenv\` to see why")
  fi

  for kind name value in ${=expected}; do
    if [[ $kind == var && ${(P)name} != $value ]]; then
      problems+=("$name is '${(P)name}', brew says '$value'; set by brew_env in ~/.dotfiles/zprofile")
    elif [[ $kind == dir && ":${(P)name}:" != *":$value:"* ]]; then
      if [[ $name == FPATH_CHECK ]]; then
        problems+=("$value missing from fpath; set in ~/.dotfiles/zsh/homebrew.zsh")
      else
        problems+=("$value missing from $name; set by brew_env in ~/.dotfiles/zprofile")
      fi
    fi
  done
fi

# batman: its --export-env output, compared with MANPAGER and MANROFFOPT
batman="$HOME/.local/bin/batman"

if [[ ! -x $batman ]]; then
  problems+=("batman not installed at $batman; run ~/.dotfiles/bin/bat_extras_install")
else
  expected=("${(@f)$(env -i HOME=$HOME PATH=$PATH /bin/zsh -fc '
    eval "$("$1" --export-env)" || exit 1
    print -r -- "$MANPAGER"
    print -r -- "$MANROFFOPT"
  ' zsh "$batman")}")

  if [[ $expected[1] != $MANPAGER ]]; then
    problems+=("MANPAGER is '$MANPAGER', batman says '$expected[1]'; set in ~/.dotfiles/zsh/bat.zsh")
  fi

  if [[ $expected[2] != $MANROFFOPT ]]; then
    problems+=("MANROFFOPT is '$MANROFFOPT', batman says '$expected[2]'; set in ~/.dotfiles/zsh/bat.zsh")
  fi
fi

# Thaw: on the beta until Thaw 3, which macOS 27 needs, reaches the stable cask
if [[ -x $brew && -d $HOMEBREW_PREFIX/Caskroom/thaw@beta ]]; then
  stable=$("$brew" info --cask --json=v2 thaw 2>/dev/null | python3 -c '
import json, sys
print(json.load(sys.stdin)["casks"][0]["version"])' 2>/dev/null)

  if [[ -z $stable ]]; then
    problems+=("could not read the thaw cask's version;"\
" run \`brew info --cask thaw\`")
  elif (( ${stable%%.*} >= 3 )); then
    problems+=("thaw $stable is stable; run"\
" \`brew uninstall --cask thaw@beta && brew install --cask thaw\`"\
" and change thaw@beta to thaw in ~/.dotfiles/Brewfile")
  fi
fi

# print -l with nothing to print still prints an empty line
if (( $#problems )); then
  print -rl -- $problems
  exit 1
fi
