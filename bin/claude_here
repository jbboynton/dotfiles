#!/usr/bin/env -S osascript -l JavaScript
// Bring Claude's window to the current Space. Claude has no New Window
// command and ignores menu commands while it's in the background, so: activate
// Claude (macOS switches to its Space), minimize its window, go back to the
// starting Space, and restore the window there. A minimized window belongs to
// no Space, so it comes back on the current one. Bound to shift-opt-cmd-/ in
// Keyboard Maestro (shift-cmd-/ still switches to Claude).
//
// The way back is counted, not guessed: the window server's (private,
// read-only) Spaces calls give the ordered Spaces and the current one, so it
// works with any number of Spaces. If "Switch to Desktop N" is turned on for
// the Space to return to, it jumps there in one move; otherwise it steps with
// control-arrow. Needs Accessibility permission (minimizing, key events), so
// it runs from Keyboard Maestro.

ObjC.import('CoreGraphics');
ObjC.import('Foundation');

ObjC.bindFunction('CGSMainConnectionID', ['int', []]);
ObjC.bindFunction('CGSGetActiveSpace', ['unsigned long long', ['int']]);
ObjC.bindFunction('CGSCopyManagedDisplaySpaces', ['id', ['int']]);

var cid = $.CGSMainConnectionID();

// The display's Spaces in order and the index of the current one
function spaces() {
  // The active Space comes back as a 64-bit value, not a plain number
  var active = Number($.CGSGetActiveSpace(cid));
  var displays = ObjC.deepUnwrap($.CGSCopyManagedDisplaySpaces(cid));

  for (var i = 0; i < displays.length; i++) {
    var ids = displays[i].Spaces.map(function (s) { return Number(s.ManagedSpaceID); });
    var at = ids.indexOf(active);
    if (at >= 0) return { ids: ids, at: at };
  }

  return null;
}

// Claude's main window: its largest normal window
function claudeWindow() {
  var list = ObjC.deepUnwrap(ObjC.castRefToObject($.CGWindowListCopyWindowInfo($.kCGWindowListOptionAll, 0)));
  var best = null;
  list.forEach(function (w) {
    var b = w.kCGWindowBounds;
    if (w.kCGWindowOwnerName !== 'Claude' || w.kCGWindowLayer !== 0 || !b || b.Height < 200) return;
    if (!best || b.Width * b.Height > best.b.Width * best.b.Height) best = { b: b, here: !!w.kCGWindowIsOnscreen };
  });
  return best;
}

// The "Switch to Desktop N" shortcut (symbolic hotkey 117 + N) as
// [key code, modifier flags], or null when it's turned off
function desktopShortcut(n) {
  var task = $.NSTask.alloc.init;
  var pipe = $.NSPipe.pipe;
  task.launchPath = '/usr/bin/defaults';
  task.arguments = ['export', 'com.apple.symbolichotkeys', '-'];
  task.standardOutput = pipe;
  task.launch;
  var data = pipe.fileHandleForReading.readDataToEndOfFile;
  task.waitUntilExit;
  var keys = ObjC.deepUnwrap($.NSPropertyListSerialization.propertyListWithDataOptionsFormatError(data, 0, null, null));
  var entry = keys && keys.AppleSymbolicHotKeys && keys.AppleSymbolicHotKeys[String(117 + n)];
  if (!entry || !entry.enabled || !entry.value) return null;
  return [entry.value.parameters[1], entry.value.parameters[2]];
}

function key(code, flags) {
  [true, false].forEach(function (down) {
    var e = $.CGEventCreateKeyboardEvent(null, code, down);
    $.CGEventSetFlags(e, flags);
    $.CGEventPost($.kCGHIDEventTap, e);
  });
}

// Wait until the active Space is the one wanted (up to 2.5 s; a switch takes
// about 1.2 s on a high refresh rate display)
function waitForSpace(index) {
  for (var i = 0; i < 100; i++) {
    var s = spaces();
    if (s && s.at === index) return true;
    delay(0.025);
  }
  return false;
}

// The hotkey's own modifiers may still be held; they mustn't mix into the
// drag or the Space switch
function waitForModifiersUp() {
  var held = $.kCGEventFlagMaskCommand | $.kCGEventFlagMaskAlternate | $.kCGEventFlagMaskShift | $.kCGEventFlagMaskControl;
  for (var i = 0; i < 40; i++) {
    if (($.CGEventSourceFlagsState($.kCGEventSourceStateHIDSystemState) & held) === 0) return;
    delay(0.025);
  }
}

// Claude's windows as Accessibility sees them (this Space, plus minimized ones)
function axWindows() {
  return Application('System Events').processes.byName('Claude').windows();
}

function minimized(win) {
  return win.attributes.byName('AXMinimized').value();
}

function run() {
  var claude = Application('Claude');
  var w = claudeWindow();

  if (!w || w.here) {
    claude.activate();
    return w ? 'already on this Space' : 'no Claude window; activated Claude';
  }

  waitForModifiersUp();
  var start = spaces();

  // macOS switches to Claude's Space on activation; the active Space changes
  // once the slide lands
  claude.activate();
  var there = spaces();

  for (var i = 0; i < 100 && start && there && there.at === start.at; i++) {
    delay(0.025);
    there = spaces();
  }

  if (!start || !there || there.at === start.at) return 'Claude activated; no Space switch to undo';

  // Minimize the main window: the largest one Accessibility sees here
  var main = null;
  axWindows().forEach(function (win) {
    var size = win.size();
    if (!minimized(win) && (!main || size[0] * size[1] > main.size()[0] * main.size()[1])) main = win;
  });

  if (!main) return 'Claude activated, but no window to minimize';
  main.attributes.byName('AXMinimized').value = true;

  for (var m = 0; m < 40 && !minimized(main); m++) delay(0.025);

  // Back to the starting Space: one jump if "Switch to Desktop N" is on for
  // it, otherwise one control-arrow per Space
  var shortcut = desktopShortcut(start.at + 1);
  var steps = start.at - there.at;
  var arrived = false;

  if (shortcut) {
    key(shortcut[0], shortcut[1]);
    arrived = waitForSpace(start.at);
  } else {
    var arrow = steps > 0 ? 124 : 123;
    var flags = $.kCGEventFlagMaskControl | $.kCGEventFlagMaskSecondaryFn;

    for (var s = 1; s <= Math.abs(steps); s++) {
      key(arrow, flags);
      arrived = waitForSpace(there.at + s * (steps > 0 ? 1 : -1));
    }
  }

  // Restore it here, then bring Claude forward
  var restored = false;
  axWindows().forEach(function (win) {
    if (!restored && minimized(win)) {
      win.attributes.byName('AXMinimized').value = false;
      restored = true;
    }
  });
  claude.activate();

  return 'back ' + Math.abs(steps) + ' Space(s)' + (shortcut ? ' with a Desktop shortcut' : '') + '; arrived: ' + arrived + '; restored: ' + restored;
}
