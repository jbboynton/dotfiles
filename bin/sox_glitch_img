#!/usr/bin/env bash

# Cactus V1
# Some combination of:
# trim 0 100s : phaser 0.9 0.85 4 0.23 1.3 -s
# trim 0 100s : echo 0.4 0.98 4 0.9

# Wicker V1
# 1st: trim 0 100s : echos 0.9 0.98 3 0.55 15 0.15
# 2nd: trim 0 100s : phaser 0.9 0.85 4 0.23 1.3 -s

input_file="$1"

sox \
  -t ul \
  -c 1 \
  -r 48k \
  "$input_file" \
  -t ul \
  "x_$input_file" \
  trim 0 100s : phaser 0.9 0.85 4 0.23 1.3 -s


