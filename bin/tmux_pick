#!/usr/bin/env bash
# Fuzzy-find a tmux window or session with fzf and switch to it. Run in
# a popup by tmux.conf's prefix f (windows) and prefix F (sessions).
#
# Usage: tmux_pick windows|sessions
#
# The window or session you are in is left off the list. The preview
# shows the bottom of the highlighted one's active pane.
#
# tmux expands no formats in a popup's command, so the client and where
# it is come from tmux itself: inside a popup, the client is the one
# that opened it.

set -euo pipefail

kind=${1:-}

case $kind in
  windows)
    format=$'#{window_id}\t#{session_name}  #{window_index}:#{window_name}'
    list=(list-windows -a -F "$format")
    current='#{window_id}'
    prompt='window> '
    ;;
  sessions)
    format=$'#{session_id}\t#{session_name}  #{session_windows} windows'
    list=(list-sessions -F "$format")
    current='#{session_id}'
    prompt='session> '
    ;;
  --preview)
    # Drop the pane's empty bottom rows, then show as much of the rest
    # as fits
    tmux capture-pane -ep -t "$2" |
      sed -e ':a' -e '/^[[:space:]]*$/{$d;N;ba' -e '}' |
      tail -n "${FZF_PREVIEW_LINES:-40}"
    exit 0
    ;;
  *)
    printf 'Usage: tmux_pick windows|sessions\n\n' >&2
    exit 2
    ;;
esac

read -r client current < <(tmux display -p "#{client_name} $current")

choice=$(
  tmux "${list[@]}" |
    awk -F '\t' -v current="$current" '$1 != current' |
    fzf --reverse --no-multi --exit-0 --prompt "$prompt" \
      --delimiter $'\t' --with-nth 2 \
      --preview "$(printf %q "$0") --preview {1}" \
      --preview-window 'down,60%,nowrap' ||
    true
)

[ -n "$choice" ] || exit 0
tmux switch-client -c "$client" -t "${choice%%$'\t'*}"
