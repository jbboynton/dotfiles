highlight QuickFixLine cterm=bold,underline ctermfg=cyan

highlight CursorParen ctermfg=green ctermbg=none
highlight MatchParen ctermfg=green ctermbg=none

highlight Search ctermfg=black ctermbg=darkgray

highlight Folded cterm=bold ctermfg=darkgray ctermbg=cyan
highlight FoldColumn ctermbg=darkgray

highlight ColorColumn ctermbg=black
highlight LineNr cterm=none ctermfg=blue ctermbg=black

highlight DiffAdd ctermfg=white ctermbg=darkgray
highlight DiffDelete ctermfg=white ctermbg=darkgray
highlight DiffChange ctermfg=white ctermbg=darkgray
highlight DiffText ctermfg=yellow ctermbg=darkgray

highlight SpellBad cterm=bold,italic ctermfg=red ctermbg=none
highlight SpellCap cterm=underline ctermfg=red ctermbg=none
highlight SpellLocal cterm=underline ctermfg=yellow ctermbg=none
highlight SpellRare cterm=underline ctermfg=red ctermbg=none

highlight Comment cterm=italic
highlight Define cterm=none ctermfg=blue

highlight Todo cterm=underline ctermfg=yellow ctermbg=none
highlight Error cterm=underline ctermfg=red ctermbg=none
highlight ErrorMsg cterm=underline ctermfg=red ctermbg=none

highlight Pmenu ctermfg=cyan ctermbg=black
highlight PmenuThumb ctermfg=green ctermbg=green
highlight PmenuSel cterm=none ctermfg=yellow ctermbg=black
highlight PmenuSbar ctermfg=black ctermbg=black

highlight WildMenu cterm=underline ctermfg=yellow ctermbg=black
highlight StatusLine cterm=none ctermfg=cyan ctermbg=black

highlight VertSplit ctermfg=black ctermbg=darkgray

highlight Visual ctermfg=none ctermbg=darkgray

augroup trailingWhitespaceGroup
  autocmd!

  highlight TrailingWhitespace ctermbg=black ctermfg=darkgray
  match TrailingWhitespace /\s\+\%#\@<!$/
  autocmd BufWinEnter * match TrailingWhitespace /\s\+\%#\@<!$/
  autocmd InsertEnter * match TrailingWhitespace /\s\+\%#\@<!$/
  autocmd InsertLeave * match TrailingWhitespace /\s\+$/
augroup end

